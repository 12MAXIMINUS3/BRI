# Copy this file to `.env.local` and fill in your values.
# Every VITE_* variable is bundled into the public site, so never put secrets here.
# The Supabase service-role key must NEVER be added to this file or any frontend code.

# --- Business details (editable placeholders) ---------------------------------
# Phase 2 moves these into the `business_settings` table, which the owner edits in
# the admin dashboard. These values remain as fallbacks.
VITE_BUSINESS_NAME="BuiltRight Interiors"
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# Digits only, including country code, for example 15551234567. Leave empty to hide WhatsApp.
VITE_WHATSAPP_NUMBER=
VITE_LOCATION=
VITE_SERVICE_AREA=

# ISO 4217 currency code, for example USD, EUR, GBP, NGN, KES or XAF.
# Until this is set, prices are shown as plain numbers with a "currency not set" note.
VITE_CURRENCY_CODE=
# BCP 47 locale used for number and date formatting, for example en-US or fr-FR. Empty = browser default.
VITE_LOCALE=

# Show "Demo" and "Placeholder" labels on sample content. Set to false only after
# replacing every demo entry with real content.
VITE_SHOW_DEMO_LABELS=true

# --- Supabase (connected in Phase 2) ------------------------------------------
# Use the public anon key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
